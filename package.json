{
  "name": "ariadne",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared-contracts",
    "packages/chat-providers",
    "packages/shared-belief-store",
    "packages/event-bus",
    "packages/talker",
    "packages/thinker",
    "packages/tts-client"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "lint": "turbo run lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "turbo": "^2.5.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
