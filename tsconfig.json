{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ariadne/shared-contracts": [
        "packages/shared-contracts/src/index.ts"
      ],
      "@ariadne/chat-providers": [
        "packages/chat-providers/src/index.ts"
      ],
      "@ariadne/shared-belief-store": [
        "packages/shared-belief-store/src/index.ts"
      ],
      "@ariadne/event-bus": [
        "packages/event-bus/src/index.ts"
      ],
      "@ariadne/talker": [
        "packages/talker/src/index.ts"
      ],
      "@ariadne/thinker": [
        "packages/thinker/src/index.ts"
      ],
      "@ariadne/tts-client": [
        "packages/tts-client/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
